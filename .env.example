# Neon Postgres pooled connection string. Get it from the Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google Gemini API key (Gemini Flash). https://aistudio.google.com/apikey
# Take the key from a Google project WITHOUT billing enabled: billing zeroes the
# free tier, and the model call then fails 429 RESOURCE_EXHAUSTED (limit: 0),
# which /api/capture turns into a 502.
GEMINI_API_KEY=

# The single PIN that unlocks the app.
APP_PIN=1234

# Server-configured timezone used to resolve spoken relative dates ("tomorrow")
# to an absolute date at capture time. Single-user — set once, don't detect.
SERVER_TZ=America/New_York

# How long (ms) an untouched capture draft waits before it self-confirms.
# Build-tune parameter; ~4000 in the prototype. Client-side (NEXT_PUBLIC_).
NEXT_PUBLIC_SELF_CONFIRM_MS=4000

# PostHog analytics. Production values live in .env.production; set these
# locally to send dev events. Unset means analytics silently no-ops.
# The project token is a public, write-only ingestion key.
# The host applies to server-side capture only — the browser always posts to the
# /ingest reverse proxy, whose upstream region is pinned in next.config.ts.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
